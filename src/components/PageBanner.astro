---
interface Props { title: string; href?: string; }
const { title, href = "/kontakt" } = Astro.props;
---
<div data-ix="show-go-top-on-scroll" id="Top" class="sub-banner custom-3258"><div class="container-center uper in-intro custom-9163 w-container"><div class="align-center custom-9647"><div class="top-margin"><h1 data-ix="move-text-up-on-load-2" class="heading-white">{title}</h1><div data-ix="move-text-up-on-load-3" class="top-margin"><a href={href} class="button-icon arrow custom-4927 w-button">Projekt anfragen</a></div></div></div></div></div>