---
import PageBanner from "@/components/PageBanner.astro";
import Scripts from "@/components/Scripts.astro";
import SiteLayout from "@/layouts/SiteLayout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import FooterDecoration from "@/components/FooterDecoration.astro";
import BackToTop from "@/components/BackToTop.astro";
import ContactPopup from "@/components/ContactPopup.astro";
import { getCollection } from "astro:content";
export async function getStaticPaths() { return (await getCollection("projekte")).map(project => ({ params: { slug: project.id }, props: { project } })); }
const { project } = Astro.props;
---
<SiteLayout rss htmlAttributes={{...{"data-wf-domain": "www.sn-trockenbau.de", "data-wf-page": "5ca4a237374efba88644480e", "data-wf-site": "5c9be19e5bef783b3aa90b95", "lang": "de", "data-wf-collection": "5ca4a237374efbad5e444833"}, "data-wf-item-slug": project.id}} bodyAttributes={{"class": "custom-0000"}} title={`${project.data.title} - S.N. Trockenbau GmbH`} description={project.data.client.trim()} image={project.data.cover}><Nav /><PageBanner title={project.data.title} href={"/kontakt"} /><div id="Top" class="section gray custom-3492"><div class="w-container"><div><div class="w-row"><div class="w-col w-col-6"><div style={`background-image:url("${project.data.images[0]}")`} class="custom-3093"></div></div><div class="w-col w-col-6"><div style={`background-image:url("${project.data.images[1]}")`} class="custom-3093"></div></div></div></div><div class="top-margin more"><div class="w-row"><div class="w-col w-col-8"><div class="left-more-padding"><h4 class="small-title">Projektbeschreibung</h4><div class="top-margin"><p>{project.data.description}</p></div></div></div><div class="w-col w-col-4"><div class="left-more-padding top-margin-device"><h4 class="small-title">Projektangaben</h4><div class="top-margin"><ul role="list" class="w-list-unstyled"><li class={project.data.partner ? undefined : "w-condition-invisible"}><div class="details-wrapper more"><p class="details-text">In Zusammenarbeit mit:</p><p class={"details-text dynamic" + (project.data.partner ? "" : " w-dyn-bind-empty")}>{project.data.partner}</p></div></li><li class={project.data.client ? undefined : "w-condition-invisible"}><div class="details-wrapper more"><p class="details-text">Kunde:</p><p class={"details-text dynamic" + (project.data.client ? "" : " w-dyn-bind-empty")}>{project.data.client}</p></div></li><li class={project.data.completion ? undefined : "w-condition-invisible"}><div class="details-wrapper more"><p class="details-text">Fertigstellung:</p><p class={"details-text dynamic" + (project.data.completion ? "" : " w-dyn-bind-empty")}>{project.data.completion}</p></div></li><li class={project.data.location ? undefined : "w-condition-invisible"}><div class="details-wrapper more"><p class="details-text">Ort:</p><p class={"details-text dynamic" + (project.data.location ? "" : " w-dyn-bind-empty")}>{project.data.location}</p></div></li></ul></div></div></div></div></div><div class="line-divider"><div class="border-top"></div></div><div><div class="w-row"><div class="w-col w-col-4"><div class="algin-center-device"><a href="/projekte" class="button-icon previous custom-8312 w-button">Alle Projekte</a></div></div><div class="w-col w-col-4"><div class="align-center top-bit-margin"><a href="/kontakt" class="button-icon no-icon custom-6985 w-button">Projekt anfragen</a></div></div><div class="w-col w-col-4"><div class="align-right algin-center-device top-bit-margin"><a href="/leistungen" class="button-icon next-project custom-2965 w-button">Alle Dienstleistungen</a></div></div></div></div></div></div><ContactPopup pageId="5ca4a237374efba88644480e" /><FooterDecoration /><Footer /><BackToTop /><Scripts /></SiteLayout>